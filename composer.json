{
  "name": "laraditz/action",
  "description": "A simple single action class for Laravel to keep your application DRY",
  "type": "laravel-package",
  "keywords": ["laravel", "action", "DRY"],
  "homepage": "https://github.com/laraditz/action",
  "license": "MIT",
  "authors": [
    {
      "name": "Raditz Farhan",
      "email": "raditzfarhan@gmail.com",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2",
    "illuminate/bus": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Laraditz\\Action\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Laraditz\\Action\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Laraditz\\Action\\ActionServiceProvider"
      ]
    }
  }
}
